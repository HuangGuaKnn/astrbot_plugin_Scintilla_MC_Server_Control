# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 测试产物 ----
tests/_shots/
tests/_out*.txt
tests/_u.txt
tests/_ui.txt
tests/_o.txt
tests/_log*.txt

# ---- 本地配置 / 备份（可能含 RCON 密码与会话 ID，绝不入库）----
_backup/
*.bak
*.bak_*
*.bak-*
plugin_config*.json

# ---- AstrBot 运行产物 / 本地一次性跑测脚本 ----
/data/*
!/data/legacy_items/
!/data/legacy_items/1.7.10.json
!/data/legacy_items/1.12.2.json
# 旧版**真 Item 注册表**快照（v0.24.3 · N04）：运行期与 CI 的判据，必须随包。
# 踩过的坑（F16）：/data/* 这种一锅端规则会把运行数据挡在包外，而门禁只看文件名时会全绿 ——
# 所以闸门里既查「在不在包」，也拿它逐条核 data/legacy_items/*.json 的成员资格。
!/data/legacy_registry/
!/data/legacy_registry/items_1.7.10.json
!/data/legacy_registry/items_1.12.2.json
run_full.py
run_ui.py

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 内审件（核验单 / 咨询单 / 实施单 / 快照 diff）——绝不入库 ----
# 这类文件是「内部往来件」：含本机绝对路径（C:\Users\...）、未发布的设计取舍与自曝账，
# 只该躺在本地（docs/_internal/ 已忽略）。公开仓库里不留任何一份、任何一次提交都不留。
docs/VERIFY_*.md
docs/CONSULT_*.md
docs/*.diff
docs/*实施单*.md
docs/_internal/
