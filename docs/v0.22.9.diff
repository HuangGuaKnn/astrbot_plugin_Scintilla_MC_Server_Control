+async def group_reissue_halted() -> None:
+    print("---- 五、P1-b 靶心：自评未完成 → 重发同一批命令必须被拦 ----")
+    rcon = StubRcon(OK_OUT)
+    agent = StubAgent([[CMD_A], [CMD_A]], success_flags=[False, True])
