+class GuardStub:
+    """把插件类里**真实**的版本守门方法绑到替身上（与 test_tool_guard.py 同一手法）。"""
+
+    def __init__(self, version: str = ""):
+        self._version = version
+        self.logger = logging.getLogger("test.guard")
